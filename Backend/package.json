{
  "name": "metroexecucare-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/setup-db.js init",
    "db:reset": "node scripts/setup-db.js reset",
    "seed": "node scripts/seed.js",
    "seed:fresh": "npm run db:reset && npm run seed",
    "test": "jest --verbose",
    "test:auth": "jest tests/auth.test.js --verbose",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "healthcare",
    "executive-checkup",
    "nodejs",
    "express",
    "jwt"
  ],
  "author": "Metrobank A07B Devs",
  "license": "Students",
  "description": "Backend API for MetroExecuCare - Executive Health Checkup Management System",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "googleapis": "^137.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "resend": "^6.1.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  }
}
