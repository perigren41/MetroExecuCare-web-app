# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=metroexecucare_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Configuration (Generate new secrets for production)
JWT_SECRET=your_jwt_secret_here_minimum_64_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_64_characters_long_for_security
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=30d

# Gmail SMTP Configuration with App Password
# Create a Gmail App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER_EMAIL=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_USE_APP_PASSWORD=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000