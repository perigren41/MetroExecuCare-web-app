# Production Environment Variables for Railway
# Copy this file and fill in the values in Railway dashboard

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Railway MySQL)
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_NAME=${MYSQLDATABASE}
DB_USER=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# JWT Configuration (IMPORTANT: Generate new secrets for production!)
JWT_SECRET=your-very-strong-jwt-secret-min-64-characters-please-change-this
JWT_REFRESH_SECRET=your-very-strong-refresh-secret-min-64-characters-please-change-this
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=30d

# Gmail SMTP Configuration
GMAIL_USER_EMAIL=metroexecucare@gmail.com
GMAIL_APP_PASSWORD=jmfh dwyb ouis pxyp
GMAIL_USE_APP_PASSWORD=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Frontend URL (Railway will provide this)
FRONTEND_URL=${FRONTEND_URL}
