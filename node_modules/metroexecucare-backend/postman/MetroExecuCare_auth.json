    {
      "name": "2. User Management - Admin (8 endpoints)",
      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('✅ Users retrieved successfully', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.data.users).to.be.an('array');",
                  "        pm.expect(response.data.pagination).to.exist;",
                  "        ",
                  "        // Store first user ID for testing",
                  "        if (response.data.users.length > 0) {",
                  "            pm.collectionVariables.set('testUserId', response.data.users[0].id);",
                  "        }",
                  "    });",
                  "} else if (pm.response.code === 403) {",
                  "    pm.test('❌ Admin role required (as expected)', function () {",
                  "        const response = pm.response.json();",
                  "        console.log('Admin access required:', response.error);",
                  "        pm.expect(response.error).to.exist;",
                  "    });",
                  "} else if (pm.response.code === 401) {",
                  "    pm.test('❌ Authentication required', function () {",
                  "        console.log('Please login first to get admin token');",
                  "        pm.expect(pm.response.code).to.eql(401);",
                  "    });",
                  "} else {",
                  "    pm.test('❌ Unexpected error', function () {",
                  "        const response = pm.response.json();",
                  "        console.log('Unexpected error:', response);",
                  "        pm.expect(response.success).to.be.false;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get all users with pagination (Admin only)"
          }
        },
        {
          "name": "Get User by ID",
