          "name": "Register User - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check if request was successful",
                  "if (pm.response.code === 201) {",
                  "    pm.test('✅ Registration successful', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.data).to.exist;",
                  "        pm.expect(response.data.user).to.exist;",
                  "        pm.expect(response.data.user.email).to.exist;",
                  "        pm.expect(response.data.user.password).to.not.exist;",
                  "        pm.expect(response.data.token).to.exist;",
                  "        ",
                  "        // Store token and user ID",
                  "        pm.collectionVariables.set('token', response.data.token);",
                  "        pm.collectionVariables.set('userId', response.data.user.id);",
                  "    });",
                  "} else {",
                  "    pm.test('❌ Registration failed - Check validation', function () {",
                  "        const response = pm.response.json();",
                  "        console.log('Registration failed:', response);",
                  "        pm.expect(response.success).to.be.false;",
                  "        pm.expect(response.error).to.exist;",
                  "    });",
                  "}",
                  "",
                  "pm.test('Response time acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
